PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Auth0 (CIAM) ----
# Leave AUTH0_DOMAIN empty to run with a built-in dev user (no login).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Optional: custom claims an Auth0 Action can add to the access token to skip Management API
# lookups: <ns>org_id, <ns>swift_user_id, <ns>servicenow_account_id, <ns>swift_reseller_id,
# <ns>salesforce_account_id. Partner roles use Auth0 RBAC permissions in the token:
# read:own-quotes (partner user) and read:all-quotes (partner admin).
AUTH0_CLAIM_NAMESPACE=https://portal/
# Machine-to-machine app (read:users, read:organizations) used to read user_metadata
# (org_id, swift_user_id, role, department) and organization metadata
# (servicenow_account_id, salesforce_account_id, swift_reseller_id, display_name).
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Local dev only (no Auth0): try the partner-user view with DEV_USER_PERMISSIONS=read:own-quotes
DEV_USER_PERMISSIONS=read:own-quotes,read:all-quotes

# ---- CMS (Drupal JSON:API): newsletters, offers, resources ----
# Leave *_BASE_URL empty to serve mock data for that system.
CMS_BASE_URL=
CMS_API_TOKEN=
CMS_NEWSLETTERS_PATH=/drupalwebsite/jsonapi/node/newsletters
CMS_OFFERS_PATH=/drupalwebsite/jsonapi/node/offers

# ---- GIG (Giganet Information Gateway / SWIFT): addresses, quotes, appointments, orders ----
GIG_BASE_URL=
GIG_API_KEY=
# The Retrieve Quotes design reuses /api/v1/partner/quotes/{id} for both history calls; override if GIG differs
GIG_USER_HISTORY_PATH=/api/v1/partner/quotes/{swift_user_id}
GIG_RESELLER_HISTORY_PATH=/api/v1/partner/quotes/{swift_reseller_id}

# ---- Confluent Cloud ksqlDB: order status updates (status bar + order update history) ----
KSQL_ENDPOINT=
KSQL_API_KEY=
KSQL_API_SECRET=
KSQL_STREAM=SERVICENOW_ORDER_UPDATES_STREAM
# Which id the stream's partner_id holds: salesforce (matches the design's example data) or servicenow (its text)
KSQL_PARTNER_ID_SOURCE=salesforce

# ---- SWIFT: Home quotes chart and product summary (not yet designed) ----
SWIFT_BASE_URL=
SWIFT_API_KEY=

# ---- Salesforce: account manager / support contacts (OAuth2 client credentials) ----
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v60.0
SF_SERVICENOW_ACCOUNT_FIELD=ServiceNow_Account_Id__c

# ---- ServiceNow: orders (GN Orders scripted API), live services and support cases ----
SN_INSTANCE_URL=
SN_CLIENT_ID=
SN_CLIENT_SECRET=
SN_API_PATH=/api/x_partner_portal/v1

COMPANY_WEBSITE_URL=https://www.giganet.uk

# ---- Outbound call behaviour ----
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2
CACHE_TTL_SECONDS=60
