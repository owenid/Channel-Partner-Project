PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Auth0 (CIAM) ----
# Leave AUTH0_DOMAIN empty to run with a built-in dev user (no login).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Namespace of the custom claims your Auth0 Action adds to the access token:
#   <ns>user_id, <ns>org_id, <ns>servicenow_account_id
# (org_id also falls back to Auth0's standard "org_id" claim when using Organizations)
AUTH0_CLAIM_NAMESPACE=https://portal/

# ---- CMS: channel partner newsletters + offers ----
# Leave *_BASE_URL empty to serve mock data for that system.
CMS_BASE_URL=
CMS_API_TOKEN=

# ---- SWIFT: recent quotes, quote history, product summary ----
SWIFT_BASE_URL=
SWIFT_API_KEY=

# ---- Salesforce: account profile + account manager (OAuth2 client credentials) ----
SF_LOGIN_URL=https://login.salesforce.com
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v60.0
SF_SERVICENOW_ACCOUNT_FIELD=ServiceNow_Account_Id__c

# ---- ServiceNow: orders, order updates, live services, support cases ----
# (assumed source - the architecture diagram does not name one yet)
SN_INSTANCE_URL=
SN_CLIENT_ID=
SN_CLIENT_SECRET=
SN_API_PATH=/api/x_partner_portal/v1

COMPANY_WEBSITE_URL=https://www.giganet.uk

# ---- Outbound call behaviour ----
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2
CACHE_TTL_SECONDS=60
